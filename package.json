{
  "name": "docs-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run gen:index",
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1",
    "build": "npm run gen:index && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "gen:index": "node ./scripts/gen-llm-index.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "0.41.2",
    "astro": "7.0.6"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
